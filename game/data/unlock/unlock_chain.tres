[resource]
script = ExtResource("1_chain")
steps = Array[ExtResource("2_step")]([SubResource("Resource_s1"), SubResource("Resource_s2"), SubResource("Resource_s3"), SubResource("Resource_s4"), SubResource("Resource_s5"), SubResource("Resource_s6")])
