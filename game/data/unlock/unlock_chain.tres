[gd_resource type="Resource" script_class="UnlockChain" format=3]

[ext_resource type="Script" path="res://data/unlock_chain.gd" id="1_chain"]
[ext_resource type="Script" path="res://data/unlock_step.gd" id="2_step"]

[sub_resource type="Resource" id="Resource_s1"]
script = ExtResource("2_step")
id = &"etape_1"
required_zones = Array[StringName]([&"vestibule"])
opens = Array[StringName]([&"atelier"])

[sub_resource type="Resource" id="Resource_s2"]
script = ExtResource("2_step")
id = &"etape_2"
required_zones = Array[StringName]([&"atelier"])
opens = Array[StringName]([&"hub_n0", &"cuisine", &"salle_d_eau", &"wc"])

[sub_resource type="Resource" id="Resource_s3"]
