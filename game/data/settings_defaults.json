{
	"fullscreen": true,
	"vsync": true,
	"window_size": [1280, 720],
	"min_window_size": [960, 540],
	"fallback_language": "en",
	"camera": {
		"sensitivity": { "min": 0.2, "max": 3.0, "step": 0.1, "default": 1.0 },
		"invert_y": false,
		"fov": { "min": 70, "max": 95, "step": 1, "default": 80, "reference_aspect": [16, 9] }
	},
	"volume": {
		"min": 0,
		"max": 100,
		"step": 5,
		"defaults": { "master": 80, "music": 70, "ambience": 100, "effects": 100 },
		"buses": { "master": "Master", "music": "Music", "ambience": "Ambience", "effects": "Effects" }
	}
}
