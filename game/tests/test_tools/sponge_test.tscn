[sub_resource type="Resource" id="room_data_sponge"]
script = ExtResource("12_room_data")
id = &"sponge_test"
name_key = "room.sponge_test"
active_axes = Array[int]([0, 2])

[node name="SpongeTest" type="Node3D"]
script = ExtResource("1_test")
tool = ExtResource("4_sponge")

[node name="Tour" parent="." instance=ExtResource("2_tour")]

[node name="Bucket" parent="." instance=ExtResource("3_bucket")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.75, 0.5, 0.1)

[node name="TestItem" parent="." instance=ExtResource("5_item")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.75, 0.5, 0.6)
item_data = ExtResource("6_small")

[node name="Disposition" type="Node" parent="."]
script = ExtResource("9_layout")
player_path = NodePath("../Tour/Player")

[node name="StorageService" type="Node" parent="."]
script = ExtResource("10_storage")

[node name="RoomProgress" type="Node" parent="."]
script = ExtResource("11_progress")
room_data = SubResource("room_data_sponge")
storage_path = NodePath("../StorageService")

[node name="Autosave" type="Node" parent="."]
script = ExtResource("7_autosave")
layout_path = NodePath("../Disposition")
progress_path = NodePath("../RoomProgress")

[node name="ProgressIndicator" parent="." instance=ExtResource("13_indicator")]
progress_path = NodePath("../RoomProgress")

[node name="PauseMenu" parent="." instance=ExtResource("8_pause")]
