[sub_resource type="GDScript" id="GDScript_greybox"]
script/source = "extends Node3D
## Test : affiche le nom du cube interagi.


func _ready() -> void:
	for cube: Node in $TestCubes.get_children():
		var it: Interactable = cube.get_node(\"Interactable\")
		it.interacted.connect(func(_player: Node) -> void: print(\"Interaction : \", cube.name))
"

